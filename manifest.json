{
  "manifest_version": 3,
  "name": "M3U8 下载助手",
  "version": "1.0.2",
  "description": "捕获 playlist.m3u8 和 hls.m3u8，按编号或页面标题命名，自动填入你的 m3u8-dl 下载网站。",
  "minimum_chrome_version": "127",
  "permissions": [
    "storage",
    "webRequest",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.missav.live/*",
    "*://*.surrit.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "M3U8 下载助手"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
